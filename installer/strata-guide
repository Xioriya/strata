#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/common.sh"

require_root
require_tool whiptail

while true; do
  choice="$(menu "Strata guided install" \
    "Install Strata GNU/Linux step by step. The target disk will be erased." \
    disks "1. Partition a disk" \
    mounts "2. Mount the partitions" \
    base "3. Extract the base system" \
    chroot "4. Enter the chroot" \
    setup "5. Finish inside strata-setup" \
    quit "6. Quit")" || break

  case "$choice" in
    disks) "$SCRIPT_DIR/setup-disks" ;;
    mounts) "$SCRIPT_DIR/setup-mounts" ;;
    base) "$SCRIPT_DIR/setup-tar" ;;
    chroot) "$SCRIPT_DIR/strata-chroot" ;;
    setup) msg "strata-setup" "Run strata-setup inside the chroot. It is already installed there." ;;
    quit) break ;;
  esac
done
